                "carga.js": "// Teste de carga do RotaExpress com Grafana k6.\n// Taxa, tamanho da rota e duração chegam por variáveis de ambiente,\n// definidas no manifesto do Job (k8s/job-carga.yaml).\nimport http from 'k6/http';\nimport { Counter, Rate, Trend } from 'k6/metrics';\n\nconst URL = __ENV.URL || 'http://rotas:8000';\nconst TAXA = Number(__ENV.TAXA || 6);           // pedidos iniciados por segundo\nconst PARADAS = __ENV.PARADAS || '9';           // entregas por rota\nconst DURACAO = Number(__ENV.DURACAO || 60);    // segundos medidos\n\nconst rotasOk = new Counter('rotas_ok');        // rotas válidas na medição\nconst falhas = new Rate('falhas');              // fração de tentativas sem rota válida\nconst latenciaOk = new Trend('latencia_ok', true); // tempo HTTP só dos sucessos\n\nconst cenario = {\n  executor: 'constant-arrival-rate',\n  rate: TAXA,\n  timeUnit: '1s',\n  preAllocatedVUs: 40,\n  maxVUs: 40,\n  gracefulStop: '10s',\n};\n\nexport const options = {\n  noConnectionReuse: true,  // cada pedido abre conexão nova; o Service escolhe o Pod a cada vez\n  summaryTrendStats: ['avg', 'med', 'p(95)', 'max'],\n  scenarios: {\n    // 10 s para aquecer; não entra nas métricas próprias.\n    aquecimento: { ...cenario, exec: 'aquecer', duration: '10s' },\n    // Começa aos 20 s: 10 s de aquecimento + 10 s para pedidos pendentes terminarem.\n    medicao: { ...cenario, exec: 'medir', startTime: '20s', duration: DURACAO + 's' },\n  },\n  thresholds: {\n    falhas: ['rate\u003c0.01'],\n    latencia_ok: ['p(95)\u003c800'],\n    'dropped_iterations{scenario:medicao}': ['count==0'],\n  },\n};\n\nfunction pedirRota() {\n  return http.get(`${URL}/api/rota?paradas=${PARADAS}`, { timeout: '5s' });\n}\n\nexport function aquecer() {\n  pedirRota();\n}\n\nexport function medir() {\n  const r = pedirRota();\n  let corpo = null;\n  try { corpo = r.json(); } catch (_) { /* resposta sem JSON conta como falha */ }\n  const ok = r.status === 200 \u0026\u0026 corpo !== null \u0026\u0026 Array.isArray(corpo.ordem);\n  falhas.add(!ok);\n  if (ok) {\n    rotasOk.add(1);\n    latenciaOk.add(r.timings.duration); // 503 rápido não pode \"melhorar\" o p95\n  }\n}\n"
            },
            "kind": "ConfigMap",
            "metadata": {
                "annotations": {
                    "kubectl.kubernetes.io/last-applied-configuration": "{\"apiVersion\":\"v1\",\"data\":{\"carga.js\":\"// Teste de carga do RotaExpress com Grafana k6.\\n// Taxa, tamanho da rota e duração chegam por variáveis de ambiente,\\n// definidas no manifesto do Job (k8s/job-carga.yaml).\\nimport http from 'k6/http';\\nimport { Counter, Rate, Trend } from 'k6/metrics';\\n\\nconst URL = __ENV.URL || 'http://rotas:8000';\\nconst TAXA = Number(__ENV.TAXA || 6);           // pedidos iniciados por segundo\\nconst PARADAS = __ENV.PARADAS || '9';           // entregas por rota\\nconst DURACAO = Number(__ENV.DURACAO || 60);    // segundos medidos\\n\\nconst rotasOk = new Counter('rotas_ok');        // rotas válidas na medição\\nconst falhas = new Rate('falhas');              // fração de tentativas sem rota válida\\nconst latenciaOk = new Trend('latencia_ok', true); // tempo HTTP só dos sucessos\\n\\nconst cenario = {\\n  executor: 'constant-arrival-rate',\\n  rate: TAXA,\\n  timeUnit: '1s',\\n  preAllocatedVUs: 40,\\n  maxVUs: 40,\\n  gracefulStop: '10s',\\n};\\n\\nexport const options = {\\n  noConnectionReuse: true,  // cada pedido abre conexão nova; o Service escolhe o Pod a cada vez\\n  summaryTrendStats: ['avg', 'med', 'p(95)', 'max'],\\n  scenarios: {\\n    // 10 s para aquecer; não entra nas métricas próprias.\\n    aquecimento: { ...cenario, exec: 'aquecer', duration: '10s' },\\n    // Começa aos 20 s: 10 s de aquecimento + 10 s para pedidos pendentes terminarem.\\n    medicao: { ...cenario, exec: 'medir', startTime: '20s', duration: DURACAO + 's' },\\n  },\\n  thresholds: {\\n    falhas: ['rate\\u003c0.01'],\\n    latencia_ok: ['p(95)\\u003c800'],\\n    'dropped_iterations{scenario:medicao}': ['count==0'],\\n  },\\n};\\n\\nfunction pedirRota() {\\n  return http.get(`${URL}/api/rota?paradas=${PARADAS}`, { timeout: '5s' });\\n}\\n\\nexport function aquecer() {\\n  pedirRota();\\n}\\n\\nexport function medir() {\\n  const r = pedirRota();\\n  let corpo = null;\\n  try { corpo = r.json(); } catch (_) { /* resposta sem JSON conta como falha */ }\\n  const ok = r.status === 200 \\u0026\\u0026 corpo !== null \\u0026\\u0026 Array.isArray(corpo.ordem);\\n  falhas.add(!ok);\\n  if (ok) {\\n    rotasOk.add(1);\\n    latenciaOk.add(r.timings.duration); // 503 rápido não pode \\\"melhorar\\\" o p95\\n  }\\n}\\n\"},\"kind\":\"ConfigMap\",\"metadata\":{\"annotations\":{},\"name\":\"carga-script\",\"namespace\":\"ops-lab\"}}\n"
